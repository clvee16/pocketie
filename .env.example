# ─── Pocketie Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Your MongoDB connection string (MongoDB Atlas or local instance)
# Example (Atlas):  mongodb+srv://username:password@cluster.mongodb.net/pocketie
# Example (local):  mongodb://localhost:27017/pocketie
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/pocketie

# ── Session Security ──────────────────────────────────────────────────────────
# A long, random secret string used to sign and verify session tokens (HMAC).
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# IMPORTANT: Change this before going to production. Keep it secret.
SESSION_HMAC_SECRET=replace_this_with_a_long_random_string_at_least_64_characters

# ── App ───────────────────────────────────────────────────────────────────────
# Set to 'production' on your live server, 'development' locally
NODE_ENV=development
